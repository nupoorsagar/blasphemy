# Server-side only. Never expose these values to the browser or commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Audit limits
MAX_CRAWL_PAGES=50
BROWSER_AUDIT_PAGES=8

# Optional explicit browser executable for managed machines
PLAYWRIGHT_EXECUTABLE_PATH=

# Optional worker callback
AUDIT_CALLBACK_BASE_URL=
AUDIT_CALLBACK_SECRET=
