# Server-only OpenAI credentials. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional worker callback for hosted/background audits.
AUDIT_CALLBACK_BASE_URL=
AUDIT_CALLBACK_SECRET=

# Audit limits
MAX_CRAWL_PAGES=50
MAX_CRAWL_CONCURRENCY=5

# Optional local/worker browser executable.
# On Windows you can point this to Chrome or Edge if auto-detection does not find it.
# PLAYWRIGHT_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
